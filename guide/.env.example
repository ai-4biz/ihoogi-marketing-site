# Server-only. Never add a key to public HTML.
OPENROUTER_API_KEY=
# Pin a model that supports JSON responses; openrouter/auto is deliberately rejected.
GUIDE_MODEL=
PORT=3080
PUBLIC_ORIGIN=http://localhost:3080
GUIDE_DB=data/guide.sqlite
# USD budget is conservatively reserved before EACH call, even on errors.
GUIDE_SESSION_USD=0.12
GUIDE_DAILY_USD=10
GUIDE_MAX_TURNS=16
# Fill only after implementing and verifying the receiver in iHoogi.
IHOOGI_IMPORT_URL=
IHOOGI_IMPORT_TOKEN=
